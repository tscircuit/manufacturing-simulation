{
  "name": "@tscircuit/manufacturing-simulation",
  "version": "0.0.1",
  "description": "Browser simulation of a 6'2\" operator assembling and packing NEMA17 motor controller units on the unit 322 floor",
  "type": "module",
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    }
  },
  "files": ["lib"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/manufacturing-simulation"
  },
  "scripts": {
    "start": "cosmos",
    "build:site": "cosmos-export",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "three": "^0.170.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "19.1.0",
    "react-cosmos": "^6.2.1",
    "react-cosmos-plugin-vite": "^6.2.0",
    "react-dom": "19.1.0",
    "three": "0.170.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.3"
  }
}
